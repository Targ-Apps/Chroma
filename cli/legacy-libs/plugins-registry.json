{
  "registryVersion": 1,
  "libraries": [
    {
      "id": "chroma-fs",
      "name": "Chroma FS",
      "version": "0.1.0",
      "categories": [
        "storage"
      ],
      "description": "Configuration-driven storage (IndexedDB and filesystem backends). ESM plugin installed via chroma add.",
      "canonical": {
        "workspacePath": "Chroma-Fs",
        "manifest": "chroma.plugin.json"
      },
      "vendor": {
        "syncFrom": "dist",
        "includeRootFiles": [
          "package.json",
          "chroma.plugin.json"
        ],
        "exampleTemplates": [
          "dynamic",
          "standard"
        ],
        "syncTargets": [
          "Chroma/cli/plugins/chroma-fs",
          "Chroma-CLI/plugins/chroma-fs"
        ]
      },
      "install": {
        "type": "plugin-built",
        "dest": "plugins/chroma-fs",
        "build": "npm install --silent && npm run build"
      },
      "chromaJson": {
        "plugin": "chroma-fs",
        "sidecar": "chroma-fs.json"
      },
      "cdn": {
        "primary": "",
        "fallbacks": []
      }
    },
    {
      "id": "chroma-style",
      "name": "Chroma Style",
      "version": "0.1.2",
      "categories": [
        "styling"
      ],
