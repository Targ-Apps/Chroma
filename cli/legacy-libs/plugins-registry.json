      "name": "Chroma T2T",
      "version": "0.1.0",
      "categories": [
        "testing"
      ],
      "description": "Test-to-test utilities and dev tooling for Chroma apps.",
      "canonical": {
        "workspacePath": "Chroma-t2t",
