          "dynamic",
          "static"
        ],
        "syncTargets": [
          "Chroma/cli/plugins/chroma-style",
          "Chroma-CLI/plugins/chroma-style"
        ]
      },
      "install": {
        "type": "plugin-copy",
        "dest": "plugins/chroma-style"
      },
      "chromaJson": {
        "plugin": "chroma-style"
      },
      "cdn": {
        "primary": "",
        "fallbacks": []
      }
    },
    {
      "id": "chroma-router",
      "name": "Chroma Router",
      "version": "0.1.0",
