{
  "name": "@chroma/fs",
  "version": "0.1.0",
  "description": "Configuration-driven storage library for Chroma apps (IndexedDB and Tauri filesystem backends).",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@tauri-apps/plugin-fs": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/plugin-fs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "fake-indexeddb": "^6.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
