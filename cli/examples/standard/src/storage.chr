import { createChromaFs } from "../plugins/chroma-fs/index.js";

let fsPromise = null;

/** Singleton Chroma-Fs instance for this app (reads chroma-fs.json). */
export function getFs() {
    if (!fsPromise) {
        fsPromise = createChromaFs({ configPath: "./chroma-fs.json" });
    }
    return fsPromise;
}
